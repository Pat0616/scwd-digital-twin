# Copy to .env.local (git-ignored) and fill in. Everything here is read on the server only.

# Where the twin comes from: "adt" (default, the live Azure Digital Twins instance) or "file" (the v4 graph export)
TWIN_SOURCE=adt

# adt: the instance URL, e.g. https://<instance>.api.<region>.digitaltwins.azure.net
ADT_URL=

# adt: a service principal with the "Azure Digital Twins Data Reader" role on the instance.
# Leave these empty to use your own `az login` session instead (local development).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# file: the ADT Explorer export to read (re-read whenever it changes, so you can edit a copy while the app runs)
# TWIN_JSON_PATH=data/scwd_digital_twin_adt_v4.json

# Move the readings' times so the newest is now (the badge says so). Default: on for "file", off for "adt".
# Turn it on for "adt" while the instance holds a snapshot whose readings are older than a day.
# TWIN_AS_OF_NOW=true
